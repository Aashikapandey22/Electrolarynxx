{
  "name": "Order",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "color_variant": {
      "type": "string"
    },
    "quantity": {
      "type": "integer",
      "default": 1
    },
    "unit_price": {
      "type": "number"
    },
    "total_price": {
      "type": "number"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "shipping_address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "postal_code": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "card_last4": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "confirmed",
        "shipped",
        "delivered",
        "cancelled"
      ],
      "default": "confirmed"
    }
  },
  "required": [
    "product_name",
    "color_variant",
    "quantity",
    "total_price",
    "customer_name",
    "customer_email",
    "shipping_address"
  ]
}
